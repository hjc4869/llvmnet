<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>llvmnet</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LlvmNet.Runtime/LlvmNet.Runtime.csproj" />
  </ItemGroup>
  <Target Name="BuildLlvmBridge" AfterTargets="Build">
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/../../scripts/build-native.sh&quot; &quot;$(TargetDir)&quot;" />
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="LlvmNet.UnitTests" />
  </ItemGroup>
  <!-- The dotnet tool package (scripts/release-artifacts.sh, TC-11): the compiler, its LLVM bridge and the sysroots in
       one package, so that "dotnet tool install -g llvmnet" gives a working thin toolchain with LLVM 22 on PATH. -->
  <PropertyGroup Condition="'$(PackLlvmnetTool)' == 'true'">
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>llvmnet</ToolCommandName>
    <PackageId>llvmnet</PackageId>
    <Description>C, C++ and Fortran through Clang and Flang 22 to .NET CIL: a compiler driver for Linux x86-64 that needs LLVM 22 on PATH.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(PackLlvmnetTool)' == 'true'">
    <None Include="$(OutDir)libllvmnet-llvm.so" Pack="true" PackagePath="tools/$(TargetFramework)/any/" />
    <None Include="$(MSBuildProjectDirectory)/../../sysroot/dotnet64-v2/**" Exclude="$(MSBuildProjectDirectory)/../../sysroot/dotnet64-v2/.*" Pack="true" PackagePath="tools/$(TargetFramework)/any/sysroot/dotnet64-v2/" />
    <None Include="$(MSBuildProjectDirectory)/../../sysroot/system-linux-x64-v1/**" Exclude="$(MSBuildProjectDirectory)/../../sysroot/system-linux-x64-v1/.*" Pack="true" PackagePath="tools/$(TargetFramework)/any/sysroot/system-linux-x64-v1/" />
    <None Include="$(MSBuildProjectDirectory)/../../sysroot/simd128/**" Exclude="$(MSBuildProjectDirectory)/../../sysroot/simd128/.*" Pack="true" PackagePath="tools/$(TargetFramework)/any/sysroot/simd128/" />
    <None Include="$(MSBuildProjectDirectory)/../../LICENSE.TXT" Pack="true" PackagePath="" />
    <None Include="$(MSBuildProjectDirectory)/../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
    <None Include="$(MSBuildProjectDirectory)/../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
