 #define KMP_ARCH_S390X 0
 #define KMP_ARCH_SPARC 0
+#define KMP_ARCH_LLVMNET 0
 
 #if KMP_OS_WINDOWS
 #if defined(_M_AMD64) || defined(__x86_64)
@@ -149,7 +157,11 @@
 #endif
 
 #if KMP_OS_UNIX
-#if defined __x86_64
+#if defined __LLVMNET_PORTABLE__
+// CIL: no assembly, no CPU identification, 64-bit pointers, x86-64 data layout.
+#undef KMP_ARCH_LLVMNET
+#define KMP_ARCH_LLVMNET 1
+#elif defined __x86_64
 #undef KMP_ARCH_X86_64
 #define KMP_ARCH_X86_64 1
 #elif defined __i386
@@ -291,7 +303,7 @@
               KMP_ARCH_AARCH64 + KMP_ARCH_MIPS + KMP_ARCH_MIPS64 +             \
