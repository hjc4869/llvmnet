+// llvmnet's portable target (dotnet64-v2) is a Linux userland: musl over Linux system-call semantics that the .NET
+// host provides, on any operating system. It defines neither __linux__ nor an architecture macro.
+#if defined(__LLVMNET_PORTABLE__)
+#undef KMP_OS_LINUX
+#define KMP_OS_LINUX 1
+#endif
+
 #if (1 != KMP_OS_LINUX + KMP_OS_DRAGONFLY + KMP_OS_FREEBSD + KMP_OS_NETBSD +   \
               KMP_OS_OPENBSD + KMP_OS_DARWIN + KMP_OS_WINDOWS + KMP_OS_HAIKU + \
               KMP_OS_HURD + KMP_OS_SOLARIS + KMP_OS_WASI + KMP_OS_AIX)
@@ -131,6 +138,7 @@
